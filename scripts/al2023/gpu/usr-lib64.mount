# /etc/systemd/system/usr-lib64.mount (Option B, EKS-parity)
# Overlay the selected NVIDIA tree's usr/lib64 over the host /usr/lib64. See usr-bin.mount for the
# upperdir rationale and the single-owner caveat.
[Unit]
Description=NVIDIA Option B overlay for /usr/lib64
# DefaultDependencies=no (EKS): a mount otherwise gets Before=local-fs.target, which cycles with the
# resolver ordered After=local-fs.target. See nvidia-driver-resolve.service.
DefaultDependencies=no
Requires=nvidia-driver-resolve.service
After=local-fs.target nvidia-driver-resolve.service
RequiresMountsFor=/var
Before=nvidia-setup.service
ConditionPathExists=/opt/nvidia/current/usr/lib64

[Mount]
What=overlay
Where=/usr/lib64
Type=overlay
Options=lowerdir=/opt/nvidia/current/usr/lib64:/usr/lib64,upperdir=/var/lib/ecs/nvidia/lib64/upper,workdir=/var/lib/ecs/nvidia/lib64/work

[Install]
WantedBy=local-fs.target
