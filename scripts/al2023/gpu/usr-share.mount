# /etc/systemd/system/usr-share.mount (Option B, EKS-parity)
# Overlay the selected NVIDIA tree's usr/share over the host /usr/share. See usr-bin.mount for the
# upperdir rationale and the single-owner caveat.
[Unit]
Description=NVIDIA Option B overlay for /usr/share
# DefaultDependencies=no (EKS): a mount otherwise gets Before=local-fs.target, which cycles with the
# resolver ordered After=local-fs.target. See nvidia-driver-resolve.service.
DefaultDependencies=no
Requires=nvidia-driver-resolve.service
After=local-fs.target nvidia-driver-resolve.service
RequiresMountsFor=/var
Before=nvidia-setup.service
ConditionPathExists=/opt/nvidia/current/usr/share

[Mount]
What=overlay
Where=/usr/share
Type=overlay
Options=lowerdir=/opt/nvidia/current/usr/share:/usr/share,upperdir=/var/lib/ecs/nvidia/share/upper,workdir=/var/lib/ecs/nvidia/share/work

[Install]
WantedBy=local-fs.target
